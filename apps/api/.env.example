# Développement local (pnpm dev) — copiez en apps/api/.env
PORT=3000
# Fichier local ; sur Vercel : libsql://ta-base.turso.io (+ DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/picross.db
# En dev, un secret aléatoire est généré si absent (les sessions sautent à chaque redémarrage).
JWT_SECRET=dev-only-secret-change-me-please-0123456789
# Le compte créé avec cet email devient administrateur.
ADMIN_EMAILS=admin@example.com
AUTO_VALIDATE=false
