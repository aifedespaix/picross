{
  "name": "@picross/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@picross/shared": "workspace:*",
    "@types/node": "^22.20.7",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  },
  "exports": {
    "./bootstrap": "./src/bootstrap.ts"
  }
}
