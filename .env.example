# Copiez ce fichier en .env (non versionné) ou renseignez ces variables dans Dokploy.

# URL publique du site, sans slash final — OBLIGATOIRE (SEO : canonical, hreflang, sitemap).
SITE_URL=https://picross.example.com

# Secret de signature des sessions — OBLIGATOIRE, 32 caractères minimum.
#   openssl rand -base64 48
JWT_SECRET=

# Emails promus administrateurs (séparés par des virgules).
ADMIN_EMAILS=

# true : les grilles créées par les joueurs sont visibles tout de suite (sinon : validation par un admin).
AUTO_VALIDATE=false
